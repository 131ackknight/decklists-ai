# Copy to .env.local and fill in. Never commit real values.

# Anthropic API key (set a monthly spend limit in the Console).
ANTHROPIC_API_KEY=

# Decklist Data read-only API (step 3).
DECKLISTDATA_API_URL=https://decklistdata.com/api/data/v1
DECKLISTDATA_API_TOKEN=

# Brew API for the site (/api/brew).
# BREW_FAKE=1 replays a saved deck with no paid calls (use it for local work and tests).
BREW_FAKE=
# Origins allowed to call the API from a browser, comma separated.
BREW_ALLOWED_ORIGINS=http://localhost:3000
# Caps: new brews per UTC day site-wide, and per visitor IP.
BREW_DAILY_CAP=10
BREW_PER_IP=2
# Upstash Redis (caps and the 24 h deck cache). Required in production unless BREW_FAKE=1.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
