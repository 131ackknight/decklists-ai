{
  "name": "decklists-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI deck brewing harness for Magic: The Gathering, built on Decklist Data.",
  "scripts": {
    "dev": "next dev",
    "dev:api": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test",
    "cards:build": "tsx scripts/build-card-index.ts",
    "figures": "tsx scripts/figures.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@upstash/redis": "^1.41.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.1.3"
}
